{
  "name": "@devstage/backstage-plugin-catalog-coverage-backend",
  "version": "0.1.0",
  "description": "Backstage backend that projects the catalog into per-repo coverage rows and drives GitHub onboarding (create catalog-info.yaml via PR or direct commit).",
  "license": "Apache-2.0",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "catalog",
    "github",
    "onboarding"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DevStageIO/devstage-backstage-plugins",
    "directory": "workspaces/catalog-coverage/plugins/catalog-coverage-backend"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "configSchema": "config.d.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "catalog-coverage",
    "pluginPackages": [
      "@devstage/backstage-plugin-catalog-coverage",
      "@devstage/backstage-plugin-catalog-coverage-backend"
    ]
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.22",
    "@backstage/backend-defaults": "backstage:^",
    "@backstage/backend-plugin-api": "backstage:^",
    "@backstage/catalog-client": "backstage:^",
    "@backstage/catalog-model": "backstage:^",
    "@backstage/config": "backstage:^",
    "@backstage/errors": "backstage:^",
    "@backstage/plugin-catalog-node": "backstage:^",
    "ai": "^4.3.16",
    "express": "^4.17.1",
    "express-promise-router": "^4.1.0",
    "js-yaml": "^4.1.0",
    "knex": "^3.0.0",
    "p-limit": "^3.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "backstage:^",
    "@backstage/cli": "backstage:^",
    "@backstage/plugin-catalog-backend": "backstage:^",
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.6",
    "@types/js-yaml": "^4.0.9",
    "@types/supertest": "^2.0.12",
    "better-sqlite3": "^11.0.0",
    "supertest": "^6.2.4"
  },
  "files": [
    "dist",
    "migrations/**/*.{js,d.ts}",
    "config.d.ts"
  ]
}
